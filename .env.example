# Copy to .env and fill in real values.
# docker compose automatically picks up .env from the project root.
# .env is git-ignored — never commit secrets.

# --- Postgres ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=filedb

# --- JWT signing key (REQUIRED) ---
# Generate with: openssl rand -base64 48
# Must be at least 32 bytes; app fails to start without it.
JWT_SECRET=
JWT_EXPIRATION=86400000

# --- First-admin bootstrap (optional but recommended on first boot) ---
# Both must be set to provision an admin row at startup. The runner is
# idempotent across restarts (skips if an admin with that username already
# exists). After the first admin is provisioned, rotate via
# POST /auth/register/admin (requires admin auth) — not env.
ADMIN_BOOTSTRAP_USERNAME=admin
ADMIN_BOOTSTRAP_PASSWORD=

# --- Storage ---
STORAGE_QUOTA=10737418240   # 10 GiB per user

# --- JVM ---
JAVA_OPTS=-Xms256m -Xmx1g
